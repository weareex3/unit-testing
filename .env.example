CLIENT_ID=veritas_p01_t2
SF_URL=https://hcm-eu10-preview.hr.cloud.sap/login?company=veritasp01T2
SF_USERNAME=your_username
SF_PASSWORD=your_password
ANTHROPIC_API_KEY=your_anthropic_api_key
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_REGION=eu-west-2
S3_BUCKET=ex3-testops-runs

# --- Auth (production requires these; app runs with no login if both are unset) ---
# Random signing secret for the login cookie. Required if TESTOPS_PIN or TESTOPS_USERS
# is set - the app refuses to boot with a weak/default value. Generate with:
#   openssl rand -hex 32
TESTOPS_AUTH_TOKEN=

# Legacy single-owner login: username is always "louie". Prefer TESTOPS_USERS / the
# Admin > Users invite flow for real people - this is a fallback, not the primary path.
TESTOPS_PIN=

# JSON array of extra users, e.g. [{"username":"a","password":"hash-or-plain","role":"tester"}]
# In practice, don't hand-edit this - use the app's own Admin > Users > Invite flow, which
# writes to storage/users.json on the persistent volume and lets each person set their own
# password via a one-time link. This env var is for bootstrapping only.
TESTOPS_USERS=

# --- WebAuthn / passkeys (optional, defaults are usually fine) ---
# WEBAUTHN_RP_ID=ex3-testops-next-production.up.railway.app
# WEBAUTHN_RP_NAME=EX3 TestOps
# WEBAUTHN_ORIGIN=https://ex3-testops-next-production.up.railway.app
